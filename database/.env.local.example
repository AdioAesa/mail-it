# MailIt Database Configuration
# Copy this file to .env and update with your actual values

# ==============================================================================
# DATABASE CONNECTION
# ==============================================================================

# Local PostgreSQL (default port 5432)
DATABASE_URL="postgresql://postgres:password@localhost:5432/mailit?schema=public"

# ==============================================================================
# CLOUD DATABASE OPTIONS
# ==============================================================================

# Railway PostgreSQL
# Get this from: Railway Dashboard → Your PostgreSQL Service → Connect
# DATABASE_URL="postgresql://postgres:password@containers-us-west-123.railway.app:5432/railway"

# Supabase PostgreSQL
# Get this from: Supabase Dashboard → Project Settings → Database → Connection String
# DATABASE_URL="postgresql://postgres:password@db.project-ref.supabase.co:5432/postgres"

# Neon PostgreSQL
# Get this from: Neon Console → Connection Details
# DATABASE_URL="postgresql://user:password@ep-cool-name-123456.us-east-2.aws.neon.tech/neondb"

# Vercel Postgres
# Get this from: Vercel Dashboard → Storage → Postgres → .env.local
# DATABASE_URL="postgres://user:password@host.postgres.vercel-storage.com/verceldb"

# ==============================================================================
# DOCKER POSTGRESQL (for local development)
# ==============================================================================

# If using Docker Compose:
# DATABASE_URL="postgresql://mailit:mailit123@localhost:5432/mailit"

# Docker compose command:
# docker run --name mailit-postgres -e POSTGRES_PASSWORD=mailit123 -e POSTGRES_USER=mailit -e POSTGRES_DB=mailit -p 5432:5432 -d postgres:15

# ==============================================================================
# PRISMA CONFIGURATION (optional)
# ==============================================================================

# Enable query logging (useful for debugging)
# PRISMA_LOG_QUERIES=true

# Connection pool settings (for production)
# POOL_TIMEOUT=10
# POOL_SIZE=5

# ==============================================================================
# NOTES
# ==============================================================================

# 1. Never commit .env file to git (it's in .gitignore)
# 2. Use strong passwords in production
# 3. Enable SSL in production: add ?sslmode=require to connection string
# 4. For production, use connection pooling with services like PgBouncer
# 5. Test connection: npx prisma db pull

# ==============================================================================
# SETUP CHECKLIST
# ==============================================================================

# 1. Copy this file:           cp .env.local.example .env
# 2. Update DATABASE_URL:       Edit .env with your database URL
# 3. Install dependencies:      npm install
# 4. Generate Prisma Client:    npm run db:generate
# 5. Run migrations:            npm run db:migrate
# 6. Seed test data:            npm run db:seed
# 7. Open Prisma Studio:        npm run db:studio
