{
  "name": "mailit-backend",
  "version": "1.0.0",
  "description": "MailIt Backend API - Gig-economy app for hand-delivered cards and letters",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "prisma:generate": "prisma generate --schema=../database/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=../database/prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema=../database/prisma/schema.prisma",
    "seed": "node scripts/seed.js",
    "seed:templates": "node scripts/create-admin-templates.js",
    "test:geocoding": "node scripts/test-geocoding.js"
  },
  "keywords": [
    "mailit",
    "delivery",
    "cards",
    "gig-economy"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@clerk/express": "^1.0.0",
    "@prisma/client": "^5.7.1",
    "cloudinary": "^1.41.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "stripe": "^14.9.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "prisma": "^5.7.1"
  }
}
